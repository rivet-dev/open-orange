---
import { AGENT_PROMPT, GET_STARTED } from '@/data/site';

// `backticks` in a step's body are inline code.
const prose = (text: string) => text.split('`').map((part, i) => ({ part, code: i % 2 === 1 }));
// The CLI's status marks: orange for dev, green for a finished deploy.
const MARK: Record<string, string> = { '●': 'text-orange', '✓': 'text-[#4ade80]' };
---

<section id="get-started" class="scroll-mt-20 rule">
	<div class="container-x section">
		<div class="flex flex-wrap items-end justify-between gap-6">
			<h2 class="h-section">Get started.</h2>
			<div class="group/agent relative">
				<button type="button" class="copy-prompt btn-secondary cursor-pointer hover:bg-paper-mid" data-copy={AGENT_PROMPT} aria-describedby="agent-prompt">
					<!-- The copy icon morphs into a check while the button has data-copied (set by Base.astro). -->
					<span class="copy-icon" aria-hidden="true">
						<svg class="copy-icon-copy" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg>
						<svg class="copy-icon-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
					</span>
					<!-- The hidden copy of the label holds the button's width while it reads "Copied". -->
					<span class="grid text-left">
						<span class="invisible [grid-area:1/1]" aria-hidden="true">Copy prompt for your agent</span>
						<span class="copy-label [grid-area:1/1]" data-copy-label aria-live="polite">Copy prompt for your agent</span>
					</span>
				</button>
				<p id="agent-prompt" role="tooltip" class="pointer-events-none absolute left-0 top-full z-30 mt-2 w-80 max-w-[calc(100vw-3rem)] sm:left-auto sm:right-0 rounded-lg bg-plate px-3.5 py-2.5 text-[13px] leading-snug text-paper dark:text-cream opacity-0 shadow-lg transition-opacity group-hover/agent:opacity-100 group-focus-within/agent:opacity-100 motion-reduce:transition-none">{AGENT_PROMPT}</p>
			</div>
		</div>

		<ol class="mt-14 md:mt-20">
			{GET_STARTED.map((step, i) => (
				<li class="grid gap-6 border-t border-line py-10 md:py-12 lg:grid-cols-2 lg:gap-16">
					<div class="flex gap-5">
						<!-- The step number on an orange: peel, stem and leaf. -->
						<svg class="-mt-3 h-[52px] w-12 shrink-0" viewBox="0 0 48 52" aria-hidden="true">
							<defs>
								<radialGradient id={`peel-${i}`} cx="0.36" cy="0.3" r="0.8">
									<stop offset="0" stop-color="#ffb35c" />
									<stop offset="0.45" stop-color="#f7861f" />
									<stop offset="1" stop-color="#d4600c" />
								</radialGradient>
								<pattern id={`pores-${i}`} width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(30)">
									<circle cx="1" cy="1" r="0.55" fill="#9a3f05" opacity="0.18" />
									<circle cx="3" cy="3" r="0.45" fill="#fff" opacity="0.14" />
								</pattern>
							</defs>
							<ellipse cx="24" cy="49.5" rx="13" ry="1.8" fill="#1a1918" opacity="0.08" />
							<circle cx="24" cy="30" r="19" fill={`url(#peel-${i})`} />
							<circle cx="24" cy="30" r="19" fill={`url(#pores-${i})`} />
							<ellipse cx="17" cy="21.5" rx="5" ry="3" fill="#fff" opacity="0.3" transform="rotate(-30 17 21.5)" />
							<path d="M24 12.5c-.2-2.2.3-4 1.4-5.2" stroke="#5b3a1a" stroke-width="1.8" stroke-linecap="round" fill="none" />
							<path d="M25.6 9.4c3-4.2 8.6-5.2 12.6-3.4-2.2 4.4-7.8 6.4-12.6 3.4z" fill="#3f9b3a" />
							<path d="M26.5 9c3.4-1.6 6.8-2.3 10-2.4" stroke="#2c7a2a" stroke-width="0.8" stroke-linecap="round" fill="none" />
							<text x="24" y="35.5" text-anchor="middle" font-size="15" font-weight="600" fill="#fff" style="font-family: var(--font-sans); paint-order: stroke" stroke="#b9530b" stroke-width="0.6" stroke-opacity="0.5">{i + 1}</text>
						</svg>
						<div>
							<h3 class="h-sub"><span class="sr-only">Step {i + 1}: </span>{step.title}</h3>
							<p class="body-copy mt-3 max-w-md text-ink-soft">{prose(step.body).map(({ part, code }) => (code ? <code class="code-chip">{part}</code> : part))}</p>
							{'links' in step ? (
								<p class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-[15px]">
									{step.links.map((link) => (
										<a href={link.href} class="link">{link.label} <span aria-hidden="true">→</span></a>
									))}
								</p>
							) : null}
						</div>
					</div>
					<div class="plate self-start">
						<div class="overflow-x-auto px-5 py-4">
							{step.commands.map((command) => (
								<p><span class="prompt">$ </span>{command}</p>
							))}
							{step.output ? (
								<div class="pt-1 [&>p]:whitespace-pre">
									<p><span class={MARK[step.output.mark]}>{step.output.mark}</span> <span class="font-semibold text-white">{step.output.status}</span>{step.output.note ? <span class="muted">{` ${step.output.note}`}</span> : null}</p>
									{step.output.rows.map(([label, value]) => (
										<p>{'  '}<span class="muted">{label.padEnd(8)}</span>{value}</p>
									))}
								</div>
							) : null}
						</div>
					</div>
				</li>
			))}
		</ol>

	</div>
</section>

<style>
	/* The copy and check icons share one cell so one can replace the other. */
	.copy-icon {
		display: grid;
	}
	.copy-icon > svg {
		grid-area: 1 / 1;
	}
	.copy-icon-check {
		color: var(--color-orange-deep);
		opacity: 0;
		transform: scale(0.4);
	}
	.copy-prompt[data-copied] {
		border-color: color-mix(in oklab, var(--color-orange) 60%, transparent);
	}
	.copy-prompt[data-copied] .copy-icon-copy {
		opacity: 0;
		transform: scale(0.4);
	}
	.copy-prompt[data-copied] .copy-icon-check {
		opacity: 1;
		transform: none;
	}
	@media (prefers-reduced-motion: no-preference) {
		.copy-icon > svg {
			transition:
				opacity 150ms ease,
				transform 260ms cubic-bezier(0.34, 1.56, 0.64, 1);
		}
		.copy-prompt[data-copied] {
			animation: copy-prompt-pop 280ms ease-out;
		}
		.copy-prompt[data-copied] .copy-label {
			animation: copy-prompt-label 200ms ease-out;
		}
	}
	@keyframes copy-prompt-pop {
		40% {
			transform: scale(1.04);
		}
	}
	@keyframes copy-prompt-label {
		from {
			opacity: 0;
			transform: translateY(3px);
		}
	}
</style>
