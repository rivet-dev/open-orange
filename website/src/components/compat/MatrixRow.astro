---
// One feature of the matrix. The row shows the status, how many cited tests
// pass, and the start of what OpenOrange does. Opening the row shows what
// Cloudflare and OpenOrange each do, notes, the workaround, and every test or
// source file behind it.
import Row from './Row.astro';
import Chip from './Chip.astro';
import { CONFORMANCE, MATRIX_LABEL, TONE_CLASS, inline, lookupTest, type MatrixEntry } from '@/data/conformance';

interface Props {
	entry: MatrixEntry;
	/** The binding this feature belongs to; the name links to its page. */
	binding?: { href: string; name: string };
	/** On the bindings page, the name links to this row on the full matrix. */
	matrixHref?: string;
	/** Start hidden; the page's filter script shows it. */
	hidden?: boolean;
}

const { entry: e, binding, matrixHref, hidden = false } = Astro.props;
const s = MATRIX_LABEL[e.status];
const nameHref = binding?.href ?? matrixHref;
const tests = e.evidence.flatMap((ev) => (ev.kind === 'test' ? [{ ref: ev, row: lookupTest(ev.file, ev.test) }] : []));
const testsPass = tests.filter(({ row }) => row?.status === 'pass').length;
const code = e.evidence.filter((ev): ev is { kind: 'code'; path: string; lines?: string } => ev.kind === 'code');
const docs = e.evidence.filter((ev): ev is { kind: 'doc'; url: string } => ev.kind === 'doc');
const testTone = (status: string | undefined) => (status === 'pass' ? 'pass' : status === 'fail' ? 'fail' : 'none');
const testResult = (row: { status: string; cause?: string | null } | null) =>
	row ? (row.status === 'pass' ? 'Pass' : row.status === 'fail' ? `Fail${row.cause ? ` · ${row.cause}` : ''}` : row.status) : 'Not in the latest run';
const haystack = `${e.name} ${e.orange} ${e.cloudflare} ${e.notes ?? ''}`.toLowerCase();
---

<Row id={e.id} data-category={e.category} data-status={e.status} data-search={haystack} hidden={hidden}>
	<Chip slot="status" tone={s.tone} label={s.label} />
	{nameHref ? (
		<a slot="name" href={nameHref} class="row-name link no-underline hover:underline after:ml-1 after:text-ink-faint after:content-['↗']" set:html={inline(e.name)} />
	) : (
		<span slot="name" class="row-name" set:html={inline(e.name)} />
	)}
	<span slot="a" class="row-preview" set:html={inline(e.orange)} />
	<span slot="end" class="row-num whitespace-nowrap">
		{tests.length ? <span class={TONE_CLASS[testsPass === tests.length ? 'pass' : testsPass === 0 ? 'fail' : 'warn'].text}>{testsPass}/{tests.length} pass</span> : null}
		{code.length ? <span class="text-ink-faint">{tests.length ? ' · ' : ''}{code.length} {code.length === 1 ? 'file' : 'files'}</span> : null}
		{!tests.length && !code.length ? <span class="text-ink-faint">—</span> : null}
	</span>

	<dl>
		<dt>On Cloudflare</dt>
		<dd set:html={inline(e.cloudflare)} />
		<dt>On OpenOrange</dt>
		<dd class="text-ink" set:html={inline(e.orange)} />
		{e.notes ? (
			<>
				<dt>Notes</dt>
				<dd set:html={inline(e.notes)} />
			</>
		) : null}
		{e.workaround ? (
			<>
				<dt>Workaround</dt>
				<dd set:html={inline(e.workaround)} />
			</>
		) : null}
		{e.unverified ? (
			<>
				<dt>Not verified by a test</dt>
				<dd set:html={inline(e.unverified)} />
			</>
		) : null}
		{tests.length ? (
			<>
				<dt>Tests</dt>
				<dd>
					<ul class="results">
						{tests.map(({ ref, row }) => (
							<li>
								<span class="flex min-w-0 items-start gap-2">
									<span class={`${TONE_CLASS[testTone(row?.status)].dot} mt-1.5`} aria-hidden="true"></span>
									<span class="min-w-0">
										<span class="block font-mono text-[12.5px] text-ink [overflow-wrap:anywhere]">{ref.file} › {ref.test}</span>
										{row?.error ? <span class="err">{row.error}</span> : null}
									</span>
								</span>
								<span class={`font-mono text-[12px] sm:whitespace-nowrap sm:text-right ${TONE_CLASS[testTone(row?.status)].text}`}>{testResult(row)}</span>
							</li>
						))}
					</ul>
				</dd>
			</>
		) : null}
		{code.length || docs.length ? (
			<>
				<dt>Source</dt>
				<dd class="flex flex-wrap gap-x-4 gap-y-1 text-[13px]">
					{code.map((c) => (
						<a href={CONFORMANCE.fileUrl(c.path, c.lines)} class="link break-all font-mono text-[12.5px]" rel="noopener">{c.path}{c.lines ? `:${c.lines}` : ''}</a>
					))}
					{docs.map((d) => (
						<a href={d.url} class="link" rel="noopener">Cloudflare docs</a>
					))}
				</dd>
			</>
		) : null}
	</dl>
</Row>
