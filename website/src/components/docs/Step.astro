---
// One step of <Steps>: an imperative title ("Bind the class"), then about two
// sentences and the command with its expected output.
interface Props {
	title: string;
	/** Anchor for the step. Defaults to the title as a slug. */
	id?: string;
}

const { title, id } = Astro.props;
const slug =
	id ??
	title
		.toLowerCase()
		.replace(/[`'"’]/g, '')
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/^-|-$/g, '');
---

<li class="step">
	<h3 id={slug} class="step-title">{title}</h3>
	<div class="step-body"><slot /></div>
</li>

<style>
	.step {
		position: relative;
		counter-increment: step;
		margin: 0;
		padding: 0;
	}
	.step + .step {
		margin-top: 2.25rem;
	}
	/* The step number sits on the rail that <Steps> draws. */
	.step::before {
		content: counter(step);
		position: absolute;
		top: -0.125rem;
		left: calc(-2rem - 0.875rem - 1px);
		display: inline-flex;
		width: 1.75rem;
		height: 1.75rem;
		align-items: center;
		justify-content: center;
		border: 1px solid var(--color-line);
		border-radius: 0.5rem;
		background: var(--color-surface);
		color: var(--color-ink);
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 500;
		line-height: 1;
	}
	.step-title {
		margin: 0 0 0.625rem;
		font-size: 1.0625rem;
		line-height: 1.5rem;
		letter-spacing: -0.01em;
	}
	.step-body > :global(:first-child) {
		margin-top: 0;
	}
	.step-body > :global(:last-child) {
		margin-bottom: 0;
	}
	.step-body > :global(:where(p, ul, ol, pre, table, blockquote)) {
		margin-top: 0.875rem;
		margin-bottom: 0.875rem;
	}
	/* No rail on a phone (Steps.astro): the number sits beside the title, and
	   the body takes the full width. */
	@media (max-width: 639px) {
		.step {
			display: grid;
			grid-template-columns: 1.75rem minmax(0, 1fr);
			column-gap: 0.75rem;
			align-items: center;
		}
		.step::before {
			position: static;
		}
		.step-title {
			margin: 0;
		}
		.step-body {
			grid-column: 1 / -1;
			margin-top: 0.75rem;
		}
	}
</style>
