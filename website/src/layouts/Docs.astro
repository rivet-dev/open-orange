---
import Base from '@/layouts/Base.astro';
import Sidebar from '@/components/docs/Sidebar.astro';
import { docsNav, flattenNav } from '@/components/docs/nav';
import { docsOgImage } from '@/og/paths';
import { breadcrumbs } from '@/data/structured-data';
import '@/components/docs/prose.css';
import type { MarkdownHeading } from 'astro';

interface Props {
	title: string;
	description: string;
	/** The search-result description, when `description` (shown under the title) runs past about 160 characters. */
	metaDescription?: string;
	/** The browser tab title, when `<title> — OpenOrange docs` reads badly. */
	headTitle?: string;
	/** The page's own route, e.g. `/docs/bindings/kv/`. */
	href: string;
	headings?: MarkdownHeading[];
	/** Repository path of the source file, for the edit link. */
	source?: string;
	/** Style the content as Markdown prose. Off for pages that bring their own layout. */
	prose?: boolean;
	/** Use the full width for content instead of an "On this page" column. */
	wide?: boolean;
}

const { title, description, metaDescription, headTitle, href, headings = [], source, prose = true, wide = false } = Astro.props;
const { groups } = await docsNav();

const links = flattenNav(groups);
const index = links.findIndex((link) => link.href === href);
const current = links[index];
const prev = index > 0 ? links[index - 1] : undefined;
const next = index !== -1 ? links[index + 1] : undefined;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

// OpenOrange › Docs › Bindings › KV. Only pages with a URL are crumbs, so sidebar groups such as "Storage" are not.
const trail = [
	{ name: 'OpenOrange', path: '/' },
	{ name: 'Docs', path: '/docs/' },
	...(href.startsWith('/docs/bindings/') && href !== '/docs/bindings/' ? [{ name: 'Bindings', path: '/docs/bindings/' }] : []),
	...(href === '/docs/' ? [] : [{ name: title, path: href }]),
];
---

<Base
	title={headTitle ?? `${title} — OpenOrange docs`}
	description={metaDescription ?? description}
	image={docsOgImage(href)}
	type="article"
	structuredData={[breadcrumbs(trail)]}
>
	<div class="container-docs">
		<div class:list={['lg:grid lg:grid-cols-[13.5rem_minmax(0,1fr)] lg:gap-12 xl:gap-16', !wide && 'xl:grid-cols-[13.5rem_minmax(0,1fr)_12rem]']}>
			<aside class="hidden lg:block">
				<div data-docs-sidebar class="sticky top-[72px] max-h-[calc(100vh-72px)] overflow-y-auto pb-12 pt-10 [scrollbar-width:thin]">
					<Sidebar groups={groups} current={href} />
				</div>
			</aside>

			<div class="min-w-0 pb-20 pt-6 lg:pt-10">
				<details class="docs-menu card mb-8 lg:hidden">
					<summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-[14px] font-medium">
						<span class="flex min-w-0 items-center gap-2">
							<svg width="16" height="16" viewBox="0 0 18 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" class="shrink-0 text-ink-faint" aria-hidden="true"><path d="M2 4.5h14M2 9h14M2 13.5h14" /></svg>
							<span class="truncate">{current ? `${current.group} / ${current.label}` : 'Documentation'}</span>
						</span>
						<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" class="chev shrink-0 text-ink-faint transition-transform motion-reduce:transition-none" aria-hidden="true"><path d="M4 6l4 4 4-4" /></svg>
					</summary>
					<div class="border-t border-line px-1 py-5">
						<Sidebar groups={groups} current={href} />
					</div>
				</details>

				<article>
					<header class="border-b border-line pb-8">
						{current && <p class="label text-orange-deep">{current.group}</p>}
						<h1 class="mt-2 text-balance text-[2.25rem] font-medium leading-[1.1] tracking-[-0.03em] md:text-[2.75rem]">{title}</h1>
						<p class="lede mt-4 max-w-2xl">{description}</p>
					</header>

					<div class:list={['mt-8', prose && 'docs-prose']}>
						<slot />
					</div>
					<slot name="after" />
				</article>

				<footer class="mt-16">
					{source && (
						<a href={`https://github.com/rivet-dev/open-orange/blob/main/${source}`} class="inline-flex items-center gap-1.5 text-[13.5px] font-medium text-ink-faint transition-colors hover:text-ink">
							<svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M11.5 1.5l3 3-9 9H2.5v-3l9-9z" /></svg>
							Edit this page on GitHub
						</a>
					)}
					{(prev || next) && (
						<nav aria-label="Previous and next pages" class="mt-6 grid gap-3 sm:grid-cols-2">
							{prev ? (
								<a href={prev.href} class="card group block px-5 py-4 transition-colors hover:border-ink/30">
									<span class="label">← Previous</span>
									<span class="mt-1 block font-medium text-ink">{prev.label}</span>
								</a>
							) : <span class="hidden sm:block" />}
							{next && (
								<a href={next.href} class="card group block px-5 py-4 text-right transition-colors hover:border-ink/30">
									<span class="label">Next →</span>
									<span class="mt-1 block font-medium text-ink">{next.label}</span>
								</a>
							)}
						</nav>
					)}
				</footer>
			</div>

			{wide ? null : toc.length > 0 ? (
				<aside class="hidden xl:block">
					<nav aria-label="On this page" class="sticky top-[72px] max-h-[calc(100vh-72px)] overflow-y-auto pb-12 pt-10 [scrollbar-width:thin]">
						<p class="label pb-3">On this page</p>
						<ul class="flex flex-col gap-1.5 border-l border-line text-[13px] leading-snug">
							{toc.map((heading) => (
								<li>
									<a href={`#${heading.slug}`} data-toc-link class:list={['-ml-px block border-l border-transparent py-0.5 text-ink-faint transition-colors hover:text-ink', heading.depth === 3 ? 'pl-6' : 'pl-3']}>{heading.text}</a>
								</li>
							))}
						</ul>
					</nav>
				</aside>
			) : <div class="hidden xl:block" />}
		</div>
	</div>
</Base>

<script>
	// Keeps the current page visible in a sidebar that scrolls on its own.
	const sidebar = document.querySelector<HTMLElement>('[data-docs-sidebar]');
	const active = sidebar?.querySelector<HTMLElement>('[aria-current="page"]');
	if (sidebar && active && active.offsetTop > sidebar.clientHeight - 80) sidebar.scrollTop = active.offsetTop - sidebar.clientHeight / 2;

	// Marks the "On this page" entry of the section in view.
	const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
	const targets = links.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1)))).filter((el): el is HTMLElement => !!el);
	if (targets.length) {
		const update = () => {
			let active = targets[0];
			for (const target of targets) if (target.getBoundingClientRect().top < 120) active = target;
			for (const link of links) link.toggleAttribute('data-active', link.hash === `#${active.id}`);
		};
		document.addEventListener('scroll', update, { passive: true });
		update();
	}
</script>
