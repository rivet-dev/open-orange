---
// The conformance report: every recorded result from packages/cloudflare-conformance,
// read at build time.
import Docs from '@/layouts/Docs.astro';
import Chip from '@/components/compat/Chip.astro';
import TipScript from '@/components/compat/TipScript.astro';
import Row from '@/components/compat/Row.astro';
import RowHead from '@/components/compat/RowHead.astro';
import ClaimRow from '@/components/compat/ClaimRow.astro';
import ResultCount from '@/components/compat/ResultCount.astro';
import ProjectRow from '@/components/compat/ProjectRow.astro';
import MatrixRow from '@/components/compat/MatrixRow.astro';
import TestGrid from '@/components/compat/TestGrid.astro';
import RunChart from '@/components/compat/RunChart.astro';
import {
	AREA_PROGRESS,
	CAUSES,
	CAUSE_MEANING,
	CHANGES,
	CLAIM_LABEL,
	CONFORMANCE,
	DO_FAILING,
	HISTORY_RUNS,
	MATRIX,
	MATRIX_CATEGORIES,
	MATRIX_LABEL,
	PROJECT_LABEL,
	RUN_LIST,
	SUMMARY,
	SYNTHETIC_FILES,
	TEMPLATES,
	TEMPLATE_LABEL,
	TEMPLATE_MODES,
	TEMPLATE_MODE_TOTALS,
	TESTS,
	TONE_CLASS,
	TRUTH,
	fmt,
	inline,
	percent,
	shortFile,
	utcTime,
	type Area,
	type MatrixStatus,
	type ProjectStatus,
	type TestRow,
} from '@/data/conformance';
import { BINDINGS, BINDING_SLUG_BY_CLAIM, BINDING_SLUG_BY_MATRIX, bindingPage } from '@/data/bindings';
import { DOCS_PAGES } from '@/data/docs-pages';

const { totals } = SUMMARY;
const score = percent(totals.all.pass, totals.all.total);
const projects = TRUTH.summary.projects;
const projectCount = TRUTH.projects.length;
const claims = TRUTH.summary.claims;
const claimTotal = Object.values(claims).reduce((a, b) => a + b, 0);
const failing = totals.all.total - totals.all.pass;

/** Notices are claims about features on the way; they lead the areas. */
const areas: Area[] = [
	...(TRUTH.notices.length
		? [{ id: 'coming-soon', title: 'Coming soon', summary: 'On the roadmap. Open a row for what to do until it lands.', claims: TRUTH.notices }]
		: []),
	...TRUTH.areas,
];

const projectFilters: { id: ProjectStatus | 'all'; label: string; count: number }[] = [
	{ id: 'all', label: 'All', count: projectCount },
	{ id: 'works', label: PROJECT_LABEL.works.label, count: projects.works },
	{ id: 'works-emulated', label: PROJECT_LABEL['works-emulated'].label, count: projects['works-emulated'] ?? 0 },
	{ id: 'partial', label: PROJECT_LABEL.partial.label, count: projects.partial },
	{ id: 'needs-secrets', label: PROJECT_LABEL['needs-secrets'].label, count: projects['needs-secrets'] },
	{ id: 'fails', label: PROJECT_LABEL.fails.label, count: projects.fails },
].filter((f) => f.count > 0 || f.id === 'all');

const matrixStatuses = (Object.keys(MATRIX_LABEL) as MatrixStatus[]).map((id) => ({
	id,
	...MATRIX_LABEL[id],
	count: MATRIX.filter((e) => e.status === id).length,
}));

const sortedProjects = [...TRUTH.projects].sort((a, b) => b.stars - a.stars);

// A row's name links straight to its binding's own page, not via the overview.
const bindingBySlug = new Map(BINDINGS.map((b) => [b.slug, b]));
const bindingLink = (slug: string | undefined) => {
	const b = slug ? bindingBySlug.get(slug) : undefined;
	return b ? { href: bindingPage(b) ?? `/docs/bindings/#${b.slug}`, name: b.product.product } : undefined;
};

const emulated = TRUTH.emulatedHibernation;
const cloud = TRUTH.cloud;
const upstreamDo = SUMMARY.perArea['Durable Objects'] ?? { pass: 0, total: 0 };
const doFailingCount = DO_FAILING.tests.length;
const firstRun = HISTORY_RUNS[0];
const runsShown = 6;
const notSupported = Object.entries(SUMMARY.notSupported);
const quotaTests = TESTS.filter((t) => t.status === 'quota');
const testName = (t: TestRow) => `${shortFile(t.file)} › ${t.test}`;
const minutes = SUMMARY.wallSeconds ? Math.round(SUMMARY.wallSeconds / 60) : null;
const sources = TRUTH.sources;
const dateOf = (iso: string) => iso.slice(0, 10);
const cloudDates = [...new Set(cloud.projects.map((p) => dateOf(p.ranAt)))].sort();

// The page's sections, in order: each one's heading and its "On this page" entry.
const toc = [
	{ depth: 2, slug: 'claims', text: 'What works, by area' },
	{ depth: 2, slug: 'beyond', text: "Past Cloudflare's limits" },
	{ depth: 2, slug: 'scaling', text: 'What each binding scales by' },
	{ depth: 2, slug: 'projects', text: `${projectCount} real projects` },
	{ depth: 2, slug: 'cloud', text: 'On Rivet Cloud' },
	{ depth: 2, slug: 'templates', text: "Cloudflare's templates" },
	{ depth: 2, slug: 'durable-objects', text: 'Durable Objects, test by test' },
	{ depth: 2, slug: 'history', text: 'How the score moved' },
	{ depth: 2, slug: 'matrix', text: 'Feature matrix' },
	{ depth: 2, slug: 'run', text: 'What was run' },
	{ depth: 2, slug: 'method', text: 'How this is scored' },
];
const heading = (slug: string) => toc.find((h) => h.slug === slug)?.text;
---

<Docs
	title="Compatibility"
	description={`${score}% of conformance tests pass. Scored against workerd's own test suite, probes run side by side with workerd, and ${projectCount} real open-source projects. Every number comes from a recorded run. Hover a dot for the test; open a row for the error.`}
	metaDescription={DOCS_PAGES['/docs/compatibility/'].description}
	href="/docs/compatibility/"
	headings={toc}
	prose={false}
>
	<dl class="flex flex-wrap gap-x-12 gap-y-4">
		<div class="flex items-baseline gap-2"><dd class="stat text-[1.75rem]">{fmt(totals.all.pass)}<span class="text-[0.6em] text-ink-faint"> / {fmt(totals.all.total)}</span></dd><dt class="text-[15px] text-ink-faint">tests pass</dt></div>
		<div class="flex items-baseline gap-2"><dd class="stat text-[1.75rem]">{projectCount}</dd><dt class="text-[15px] text-ink-faint">real projects run</dt></div>
		<div class="flex items-baseline gap-2"><dd class="stat text-[1.75rem]">{TRUTH.summary.unmodified}</dd><dt class="text-[15px] text-ink-faint">of them unmodified</dt></div>
		<div class="flex items-baseline gap-2"><dd class="stat text-[1.75rem]">{claims.works}<span class="text-[0.6em] text-ink-faint"> / {claimTotal}</span></dd><dt class="text-[15px] text-ink-faint">claims fully hold</dt></div>
	</dl>
	<p class="caption mt-6">
		Run {SUMMARY.date} · OpenOrange <code class="code-chip">{SUMMARY.orange.sha}</code> · RivetKit <code class="code-chip">{SUMMARY.rivetkit.split('.').pop()}</code> · <a href={CONFORMANCE.workerdUrl} class="link" rel="noopener">workerd {SUMMARY.workerd.tag}</a>
	</p>
	<div class="card mt-10 p-6 md:p-8">
		<TestGrid />
		<div class="mt-10 grid gap-10 border-t border-line pt-8 md:grid-cols-2 md:gap-14">
			<div>
				<p class="label">Why {fmt(failing)} tests fail</p>
				<ul class="mt-4 divide-y divide-line">
					{CAUSES.map((c) => (
						<li class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-4 py-3 text-[14px]">
							<span class="text-ink">{c.cause}</span>
							<span class="row-num">{c.count}</span>
							{CAUSE_MEANING[c.cause] ? <span class="text-[13px] leading-snug text-ink-faint">{CAUSE_MEANING[c.cause]}</span> : null}
						</li>
					))}
				</ul>
			</div>
			<div>
				<p class="label">What is counted</p>
				<ul class="mt-4 divide-y divide-line text-[14px] text-ink">
					<li class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-4 py-3"><span>workerd's own suite</span><span class="row-num">{fmt(totals.upstream.pass)} / {fmt(totals.upstream.total)}</span></li>
					<li class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-4 py-3"><span>OpenOrange's Durable Object tests<span class="block text-[13px] leading-snug text-ink-faint">Counted under Durable Objects above.</span></span><span class="row-num">{totals.synthetic.pass} / {totals.synthetic.total}</span></li>
					<li class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-4 py-3"><span>Not counted<span class="block text-[13px] leading-snug text-ink-faint">{fmt(totals.workerdOnly)} workerd-only tests that fail on plain Node.js too, {totals.infraExcluded} the runner could not host{totals.cloudflareQuotaCut ? `, and ${totals.cloudflareQuotaCut} cut short by a Cloudflare quota` : ''}.</span></span><span class="row-num">{fmt(totals.workerdOnly + totals.infraExcluded + (totals.cloudflareQuotaCut ?? 0))}</span></li>
				</ul>
			</div>
		</div>
	</div>

	<section id="claims" class="mt-16 scroll-mt-20 border-t border-line pt-10">
		<div>
			<h2 class="text-[1.75rem] font-medium leading-tight tracking-[-0.025em]">{heading('claims')}</h2>
			<div class="mt-3">
				<p class="max-w-2xl text-[16px] leading-[1.6] text-ink-soft">A claim is <span class="font-medium text-ink">Works</span> when every recorded result behind it passed, <span class="font-medium text-ink">Partial</span> when some did, and <span class="font-medium text-ink">Does not work</span> when none did.</p>
				<ul class="mt-6 flex flex-wrap gap-2">
					{areas.map((a) => (
						<li><a href={`#area-${a.id}`} class="pill">{a.title} <span class="text-ink-faint">{a.claims.length}</span></a></li>
					))}
				</ul>
			</div>
		</div>

		<div class="mt-16 space-y-16">
			{areas.map((a) => (
				<div id={`area-${a.id}`} class="scroll-mt-24">
					<h3 class="text-[1.125rem] font-medium leading-snug tracking-[-0.015em]">{a.title}</h3>
					<p class="mt-1 text-[14.5px] leading-[1.5] text-ink-faint" set:html={inline(a.summary)} />
					<div class="mt-6">
						<RowHead name={a.id === 'bindings' ? 'Binding' : 'Feature'} end="Results">
							<div class="rows">
								{a.claims.map((c) => (
									<ClaimRow claim={c} binding={bindingLink(BINDING_SLUG_BY_CLAIM[c.id])} />
								))}
							</div>
						</RowHead>
					</div>
				</div>
			))}
		</div>
	</section>

	<section id="beyond" class="mt-16 scroll-mt-20 border-t border-line pt-10">
		<div>
			<h2 class="text-[1.75rem] font-medium leading-tight tracking-[-0.025em]">{heading('beyond')}</h2>
			<p class="mt-3 max-w-2xl text-[16px] leading-[1.6] text-ink-soft">Where OpenOrange does more than the platform allows. Each row is a probe that ran.</p>
		</div>
		<div class="mt-12">
			<RowHead name="Limit" end="Results">
				<div class="rows">
					{TRUTH.beyond.map((c) => (
						<ClaimRow claim={c} />
					))}
				</div>
			</RowHead>
		</div>
	</section>

	<section id="scaling" class="mt-16 scroll-mt-20 border-t border-line pt-10">
		<div>
			<h2 class="text-[1.75rem] font-medium leading-tight tracking-[-0.025em]">{heading('scaling')}</h2>
			<p class="mt-3 max-w-2xl text-[16px] leading-[1.6] text-ink-soft">The unit that adds capacity, and what runs one of them.</p>
		</div>
		<div class="mt-12">
			<RowHead name="Binding" a="Scales by" b="What runs one unit" end="Results">
				<div class="rows">
					{TRUTH.scaling.map((r) => {
						const s = CLAIM_LABEL[r.status];
						return (
							<Row>
								<Chip slot="status" tone={s.tone} label={s.label} />
								<span slot="name" class="row-name">{r.binding}</span>
								<span slot="a" class="row-text text-ink">{r.scalesBy}</span>
								<span slot="b" class="text-[13.5px] leading-snug text-ink-soft" set:html={inline(r.detail)} />
								<ResultCount slot="end" evidence={r.evidence} />
							</Row>
						);
					})}
				</div>
			</RowHead>
		</div>
	</section>

	<section id="projects" class="mt-16 scroll-mt-20 border-t border-line pt-10">
		<div>
			<h2 class="text-[1.75rem] font-medium leading-tight tracking-[-0.025em]">{heading('projects')}</h2>
			<p class="mt-3 max-w-2xl text-[16px] leading-[1.6] text-ink-soft">
				Open-source Cloudflare Workers with Durable Objects, run on OpenOrange as published. {TRUTH.summary.unmodified} needed no change.
			</p>
		</div>

		<dl class="mt-12 flex flex-wrap gap-x-12 gap-y-4">
			{TRUTH.summary.failedSteps.map((f) => (
				<div class="flex items-baseline gap-2"><dd class="stat text-[1.75rem]">{f.steps}</dd><dt class="text-[15px] text-ink-faint">steps failed · {f.label}</dt></div>
			))}
		</dl>

		<div class="mt-10 flex flex-wrap gap-2" role="group" aria-label="Filter projects" data-project-filters>
			{projectFilters.map((f, i) => (
				<button type="button" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'} class="pill">
					{f.label} <span class="opacity-60">{f.count}</span>
				</button>
			))}
		</div>

		<div class="mt-6">
			<RowHead name="Project" a="Size" b="Why a step failed" end="Steps passed">
				<div class="rows" data-project-list>
					{sortedProjects.map((p) => (
						<ProjectRow project={p} />
					))}
				</div>
			</RowHead>
		</div>

		<details class="mt-8" id="emulated-hibernation">
			<summary class="cursor-pointer text-[14px] font-medium text-ink-soft hover:text-ink">
				{emulated.steps.ran === 0
					? `No emulated hibernation run is recorded for the ${emulated.steps.total} steps that fail for lack of hibernation`
					: `With emulated hibernation, ${emulated.steps.pass} of the ${emulated.steps.total} steps that fail for lack of hibernation pass, in ${emulated.projects} projects`}
			</summary>
			<div class="mt-4 max-w-3xl space-y-3 text-[14px] leading-[1.6] text-ink-soft">
				<p set:html={inline(emulated.note)} />
				<p class="caption">{emulated.steps.ran} of {emulated.steps.total} steps reran this way, at OpenOrange <code class="code-chip">{emulated.orange.join(', ')}</code>, {dateOf(emulated.ranAt)}.</p>
			</div>
		</details>

		{TRUTH.excluded.length ? (
			<details class="mt-4">
				<summary class="cursor-pointer text-[14px] font-medium text-ink-soft hover:text-ink">{TRUTH.excluded.length} candidates were left out</summary>
				<ul class="mt-4 divide-y divide-line rounded-xl border border-line bg-surface text-[13.5px]">
					{TRUTH.excluded.map((x) => (
						<li class="grid gap-1 px-4 py-2.5 sm:grid-cols-[14rem_1fr]">
							<span class="text-ink">{x.repo} <span class="text-ink-faint">{fmt(x.stars)} stars</span></span>
							<span class="text-ink-soft">{x.reason}</span>
						</li>
					))}
				</ul>
			</details>
		) : null}
	</section>

	<section id="cloud" class="mt-16 scroll-mt-20 border-t border-line pt-10">
		<div>
			<h2 class="text-[1.75rem] font-medium leading-tight tracking-[-0.025em]">{heading('cloud')}</h2>
			<p class="mt-3 max-w-2xl text-[16px] leading-[1.6] text-ink-soft" set:html={inline(cloud.notes[0] ?? '')} />
		</div>
		<div class="mt-12">
			<RowHead name="Project" a="Deployed with" b="What it is" end="Steps">
				<div class="rows">
					{cloud.projects.map((p) => {
						const ran = p.counts.pass + p.counts.fail;
						const tone = p.counts.fail === 0 ? 'pass' : p.counts.pass === 0 ? 'fail' : 'warn';
						return (
							<Row id={`cloud-${p.project}`}>
								<Chip slot="status" tone={tone} label={tone === 'pass' ? 'Works' : tone === 'warn' ? 'Partial' : 'Fails'} />
								<span slot="name" class="row-name">{p.project}<span class="row-meta font-normal">{p.repo}</span></span>
								<span slot="a" class="row-text-faint"><code class="font-mono text-[12.5px]">{p.deployedWith}</code> · {p.plan} cluster · {dateOf(p.ranAt)}</span>
								<span slot="b" class="row-text" set:html={inline(p.what)} />
								<span slot="end" class={`row-num whitespace-nowrap ${TONE_CLASS[tone].text}`}>{p.counts.pass}/{ran} pass</span>
								<dl>
									<dt>What ran</dt>
									<dd set:html={inline(p.ran)} />
									{p.shortfalls.length ? (
										<>
											<dt>Where it falls short</dt>
											<dd>
												<ul class="list-disc space-y-1.5 pl-5">
													{p.shortfalls.map((s) => <li set:html={inline(s)} />)}
												</ul>
											</dd>
										</>
									) : null}
									<dt>Steps</dt>
									<dd>
										<ul class="results">
											{p.steps.map((s) => {
												const t = s.status === 'pass' ? 'pass' : s.status === 'fail' ? 'fail' : 'none';
												const label = s.status === 'pass' ? 'Pass' : s.status === 'fail' ? 'Fail' : s.status === 'needs-secrets' ? 'Needs secrets' : 'Not applicable';
												return (
													<li>
														<span class="flex min-w-0 items-start gap-2">
															<span class={`${TONE_CLASS[t].dot} mt-1.5`} aria-hidden="true"></span>
															<span class="min-w-0">
																<span class="block text-ink" set:html={inline(s.name)} />
																{s.note ? <span class="block text-ink-faint" set:html={inline(s.note)} /> : null}
																{s.secrets?.length ? <span class="block text-ink-faint">Needs {s.secrets.join(', ')}</span> : null}
																{s.error ? <span class="err">{s.error}</span> : null}
															</span>
														</span>
														<span class={`whitespace-nowrap font-mono text-[12px] sm:text-right ${TONE_CLASS[t].text}`}>{label}</span>
													</li>
												);
											})}
										</ul>
									</dd>
									<dt>Source</dt>
									<dd><a href={`https://github.com/${p.repo}/tree/${p.commit}`} class="link" rel="noopener">{p.repo}</a> at <code>{p.commit.slice(0, 7)}</code>{p.directory !== '.' ? <>, in <code>{p.directory}</code></> : null}.</dd>
								</dl>
							</Row>
						);
					})}
				</div>
			</RowHead>
		</div>
		{cloud.notes.length > 1 ? (
			<details class="mt-8">
				<summary class="cursor-pointer text-[14px] font-medium text-ink-soft hover:text-ink">How these runs were set up</summary>
				<ul class="mt-4 max-w-3xl list-disc space-y-2 pl-5 text-[14px] leading-[1.6] text-ink-soft">
					{cloud.notes.slice(1).map((n) => <li set:html={inline(n)} />)}
				</ul>
			</details>
		) : null}
	</section>

	<section id="templates" class="mt-16 scroll-mt-20 border-t border-line pt-10">
		<div>
			<h2 class="text-[1.75rem] font-medium leading-tight tracking-[-0.025em]">{heading('templates')}</h2>
			<p class="mt-3 max-w-2xl text-[16px] leading-[1.6] text-ink-soft">
				{TEMPLATES.projects.length} templates from Cloudflare, each run on OpenOrange beside <code class="code-chip">wrangler dev</code> {TEMPLATES.wrangler} in three modes. Recorded by hand at OpenOrange {TEMPLATES.after.orange}, {TEMPLATES.after.date}; "was" is the run at {TEMPLATES.before.orange}, {TEMPLATES.before.date}.
			</p>
		</div>

		<dl class="mt-12 grid gap-8 md:grid-cols-3">
			{TEMPLATE_MODE_TOTALS.map((m) => (
				<div>
					<dt class="text-[15px] font-medium text-ink">{m.label}</dt>
					<dd class="mt-2 flex flex-wrap items-baseline gap-x-5 gap-y-1">
						<span class="flex items-baseline gap-2"><span class="stat text-[1.75rem]">{m.works}</span><span class="text-[14px] text-ink-faint">work · was {m.worksBefore}</span></span>
						<span class="flex items-baseline gap-2"><span class="stat text-[1.75rem]">{m.starts}</span><span class="text-[14px] text-ink-faint">start · was {m.startsBefore}</span></span>
					</dd>
					<dd class="mt-2 text-[13px] leading-snug text-ink-faint" set:html={inline(m.meaning)} />
				</div>
			))}
		</dl>

		<dl class="mt-8 grid gap-x-8 gap-y-2 text-[13px] sm:grid-cols-2 lg:grid-cols-4">
			{Object.values(TEMPLATE_LABEL).map((s) => (
				<div class="flex items-start gap-2">
					<span class={`${TONE_CLASS[s.tone].dot} mt-1.5`}></span>
					<span><dt class="inline font-medium text-ink">{s.label}.</dt> <dd class="inline text-ink-soft" set:html={inline(s.meaning)} /></span>
				</div>
			))}
		</dl>

		<div class="mt-8">
			<RowHead name="Template" end="Modes that work">
				<div class="rows">
					{TEMPLATES.projects.map((p) => {
						const modes = TEMPLATE_MODES.map((m) => ({
							label: m.label,
							now: TEMPLATE_LABEL[p.after[m.id]],
							was: p.before[m.id] !== p.after[m.id] ? TEMPLATE_LABEL[p.before[m.id]].label : null,
						}));
						const works = TEMPLATE_MODES.filter((m) => p.after[m.id] === 'works').length;
						const tone = works === TEMPLATE_MODES.length ? 'pass' : works === 0 ? 'fail' : 'warn';
						return (
							<Row id={`template-${p.project}`}>
								<span slot="name" class="row-name">{p.project}</span>
								<span slot="a" class="flex flex-wrap gap-x-4 gap-y-1 text-[13px] text-ink-soft">
									{modes.map((m) => (
										<span class="inline-flex items-center gap-1.5" title={m.now.label}>
											<span class={TONE_CLASS[m.now.tone].dot} aria-hidden="true"></span>
											{m.label}<span class="sr-only">: {m.now.label}</span>
										</span>
									))}
								</span>
								<span slot="end" class={`row-num ${TONE_CLASS[tone].text}`}>{works}/{TEMPLATE_MODES.length}</span>
								<dl>
									{modes.map((m) => (
										<>
											<dt>{m.label}</dt>
											<dd class="flex flex-wrap items-center gap-x-2 gap-y-1"><Chip tone={m.now.tone} label={m.now.label} />{m.was ? <span class="text-[13px] text-ink-faint">was {m.was}</span> : null}</dd>
										</>
									))}
									<dt>Flows tested</dt>
