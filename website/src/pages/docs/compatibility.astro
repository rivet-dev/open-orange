			{[
				{
					what: "workerd's suite",
					where: `${SUMMARY.orange.sha}${SUMMARY.orange.dirty ? ' (uncommitted changes)' : ''}`,
					detail: `${SUMMARY.label}. ${SUMMARY.note} ${fmt(totals.files - totals.syntheticFiles)} workerd test files and ${totals.syntheticFiles} of OpenOrange's own: ${fmt(totals.upstream.total)} + ${totals.synthetic.total} tests. workerd ${SUMMARY.workerd.tag} at ${SUMMARY.workerd.commit.slice(0, 7)}, RivetKit ${SUMMARY.rivetkit}.${minutes ? ` The run took ${minutes} minutes.` : ''}`,
					when: `${utcTime(SUMMARY.startedAt)} UTC`,
