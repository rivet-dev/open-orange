								{r.latest ? <Chip slot="status" tone="pass" label="Latest" /> : r.manual ? <Chip slot="status" tone="none" label="By hand" /> : <span slot="status"></span>}
								<span slot="name" class="row-name">{r.name}</span>
								<span slot="a" class="row-text-faint">{r.sha ? <code class="font-mono text-[12.5px] text-ink-soft">{r.sha}</code> : 'no commit'} · {r.date}</span>
								<span slot="b" class="row-text-faint font-mono text-[12px]">{r.rivetkit ?? '—'}</span>
								<span slot="end" class="flex items-center gap-2.5 md:justify-end">
