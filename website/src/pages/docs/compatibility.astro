				{ what: 'Emulated hibernation', where: emulated.orange.join(', '), detail: `The ${emulated.steps.total} real-project steps that need hibernation, rerun. RivetKit ${emulated.rivetkit.join(', ')}.`, when: dateOf(emulated.ranAt) },
