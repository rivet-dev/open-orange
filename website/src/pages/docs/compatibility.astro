	<TipScript />

	<script>
		// Project filter.
		const projectFilters = document.querySelector<HTMLElement>('[data-project-filters]');
		const projectRows = Array.from(document.querySelectorAll<HTMLElement>('[data-project-list] > details'));
		projectFilters?.addEventListener('click', (event) => {
			const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-filter]');
			if (!button) return;
			const filter = button.dataset.filter ?? 'all';
			for (const b of projectFilters.querySelectorAll('button')) b.setAttribute('aria-pressed', b === button ? 'true' : 'false');
			for (const row of projectRows) row.hidden = filter !== 'all' && row.dataset.status !== filter;
		});

		// Matrix filter: category, statuses (any of the pressed ones), and a search.
		const categories = document.querySelector<HTMLElement>('[data-matrix-categories]');
		const statuses = document.querySelector<HTMLElement>('[data-matrix-statuses]');
		const search = document.querySelector<HTMLInputElement>('[data-matrix-search]');
		const count = document.querySelector<HTMLElement>('[data-matrix-count]');
		const empty = document.querySelector<HTMLElement>('[data-matrix-empty]');
		const list = document.querySelector<HTMLElement>('[data-matrix-list]');
		const rows = Array.from(list?.querySelectorAll<HTMLElement>(':scope > details') ?? []);
		const headings = Array.from(list?.querySelectorAll<HTMLElement>('[data-category-heading]') ?? []);
		let category = 'all';
		const pressed = new Set<string>();

		function apply() {
			const q = (search?.value ?? '').trim().toLowerCase();
			let shown = 0;
			const shownPerCategory = new Map<string, number>();
			for (const row of rows) {
				const c = row.dataset.category ?? '';
				const ok =
					(category === 'all' || c === category) &&
					(pressed.size === 0 || pressed.has(row.dataset.status ?? '')) &&
					(q === '' || (row.dataset.search ?? '').includes(q));
				row.hidden = !ok;
				if (ok) {
					shown += 1;
					shownPerCategory.set(c, (shownPerCategory.get(c) ?? 0) + 1);
				}
			}
			for (const h of headings) h.hidden = (shownPerCategory.get(h.dataset.categoryHeading ?? '') ?? 0) === 0;
			if (count) count.textContent = shown === rows.length ? '' : `${shown} of ${rows.length}`;
			if (empty) empty.hidden = shown !== 0;
		}

		categories?.addEventListener('click', (event) => {
			const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-category]');
			if (!button) return;
			category = button.dataset.category ?? 'all';
			for (const b of categories.querySelectorAll('button')) b.setAttribute('aria-pressed', b === button ? 'true' : 'false');
			apply();
		});
		statuses?.addEventListener('click', (event) => {
			const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-status]');
			if (!button) return;
			const id = button.dataset.status ?? '';
			if (pressed.has(id)) pressed.delete(id);
			else pressed.add(id);
			button.setAttribute('aria-pressed', pressed.has(id) ? 'true' : 'false');
			apply();
		});
		search?.addEventListener('input', apply);

		// A link to a row opens it, and clears any filter that hides it.
		function reveal() {
			const id = decodeURIComponent(location.hash.slice(1));
			if (!id) return;
			const target = document.getElementById(id);
			if (!(target instanceof HTMLDetailsElement)) return;
			if (target.hidden) {
				category = 'all';
				pressed.clear();
				if (search) search.value = '';
				for (const b of categories?.querySelectorAll('button') ?? []) b.setAttribute('aria-pressed', b.dataset.category === 'all' ? 'true' : 'false');
				for (const b of statuses?.querySelectorAll('button') ?? []) b.setAttribute('aria-pressed', 'false');
				for (const row of projectRows) row.hidden = false;
				for (const b of projectFilters?.querySelectorAll('button') ?? []) b.setAttribute('aria-pressed', b.dataset.filter === 'all' ? 'true' : 'false');
				apply();
			}
			target.open = true;
			target.scrollIntoView({ block: 'start' });
		}
		window.addEventListener('hashchange', reveal);
		reveal();
	</script>
