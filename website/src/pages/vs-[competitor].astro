---
// /vs-durable-objects/, /vs-celld/, /vs-rivet/ and /vs-miniflare/. All copy
// lives in src/data/compare.ts. /vs-workerd/ has its own page.
import Base from '@/layouts/Base.astro';
import Cta from '@/components/Cta.astro';
import { AS_OF, COMPARISONS, type Comparison, type Mark, type Product } from '@/data/compare';
import { SITE } from '@/data/site';

export function getStaticPaths() {
	return COMPARISONS.map((page) => ({ params: { competitor: page.slug }, props: { page } }));
}

interface Props {
	page: Comparison;
}

const { page } = Astro.props;
const { them, us } = page;

const MARK_LABEL: Record<Mark, string> = { yes: 'Yes', partial: 'Partly', no: 'No' };
const badgeClass = (badge: NonNullable<Product['badge']>, onPlate: boolean) =>
	badge.tone === 'good'
		? onPlate
			? 'chip bg-orange text-white'
			: 'chip-good'
		: onPlate
			? 'chip border border-dashed border-white/25 text-cream/70'
			: 'chip-muted';
const pickGrid = page.picks.length === 3 ? 'lg:grid-cols-3' : 'md:grid-cols-2';
---

<Base title={page.title} description={page.description}>
	<!-- Head to head. -->
	<section>
		<div class="container-x pt-20 pb-20 md:pt-28 md:pb-28">
			<p class="label">As of <time datetime={AS_OF.iso}>{AS_OF.label}</time></p>
			<h1 class="h-hero mt-5 max-w-4xl">{page.headline}</h1>
			<p class="lede mt-6 max-w-2xl">{page.lede}</p>

			<div class="relative mt-12 grid gap-4 md:mt-16 md:grid-cols-2 md:gap-6">
				<div class="rounded-2xl bg-plate p-7 text-white md:p-10">
					<p class="text-[2.25rem] font-medium leading-none tracking-[-0.03em] md:text-[3rem]">{us.name}</p>
					{us.badge ? <p class="mt-5"><span class={badgeClass(us.badge, true)}>{us.badge.text}</span></p> : null}
					<p class="body-copy mt-5 max-w-md text-cream/75">{us.body}</p>
				</div>
				<div class="card p-7 md:p-10">
					<p class="text-[2.25rem] font-medium leading-none tracking-[-0.03em] md:text-[3rem]">{them.name}</p>
					{them.badge ? <p class="mt-5"><span class={badgeClass(them.badge, false)}>{them.badge.text}</span></p> : null}
					<p class="body-copy mt-5 max-w-md text-ink-soft">{them.body}</p>
				</div>
				<span class="absolute left-1/2 top-1/2 hidden h-12 w-12 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-line bg-surface text-[13px] font-semibold md:flex" aria-hidden="true">vs</span>
			</div>
		</div>
	</section>

	{page.reasons ? (
		<section id="why" class="scroll-mt-20 rule">
			<div class="container-x section split-head">
				<div class="lg:sticky lg:top-24">
					<h2 class="h-section">{page.reasons.title}</h2>
					{page.reasons.lede ? <p class="lede mt-6 max-w-xl">{page.reasons.lede}</p> : null}
				</div>
				<ol class="divide-y divide-line border-y border-line">
					{page.reasons.items.map((reason, i) => (
						<li class="grid grid-cols-[2.25rem_minmax(0,1fr)] py-6">
							<span class="pt-[3px] font-mono text-[12.5px] tabular-nums text-orange-deep" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
							<div>
								<h3 class="h-card">{reason.title}</h3>
								<p class="body-copy mt-2 text-ink-soft">{reason.body}</p>
								{reason.evidence ? <p class="mt-3 border-l-2 border-line pl-3 text-[13.5px] leading-snug text-ink-faint">{reason.evidence}</p> : null}
							</div>
						</li>
					))}
				</ol>
			</div>
		</section>
	) : null}

	<!-- When to use which. -->
	<section id="when" class="scroll-mt-20 rule">
		<div class="container-x section">
			<h2 class="h-section">When to use which</h2>
			<div class={`mt-10 grid gap-4 md:gap-6 ${pickGrid}`}>
				{page.picks.map((pick) => (
					<div class={pick.highlight ? 'rounded-2xl bg-plate p-7 text-white md:p-8' : 'card p-7 md:p-8'}>
						<h3 class={`h-sub ${page.picks.length === 3 ? 'lg:text-[1.375rem]' : ''}`}>{pick.title}</h3>
						{pick.lead ? <p class={`mt-3 text-[15px] leading-snug ${pick.highlight ? 'text-cream/70' : 'text-ink-soft'}`}>{pick.lead}</p> : null}
						<ul class={`mt-5 divide-y ${pick.highlight ? 'divide-white/10' : 'divide-line'}`}>
							{pick.items.map((item) => (
								<li class="flex items-start gap-3 py-3.5 text-[15px] leading-snug">
									<span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-orange" aria-hidden="true"></span>
									{item}
								</li>
							))}
						</ul>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- The matrix. -->
	<section id="compare" class="scroll-mt-20 rule">
		<div class="container-x section">
			<h2 class="h-section">{page.matrix.title}</h2>
			<div class="card mt-10 overflow-hidden">
				<table class="matrix w-full text-left">
					<thead>
						<tr>
							<th scope="col" class="w-[28%]"><span class="sr-only">Feature</span></th>
							<th scope="col" class="oo w-[36%] text-orange-deep">{us.name}</th>
							<th scope="col">{them.name}</th>
						</tr>
					</thead>
					<tbody>
						{page.matrix.rows.map((row) => 'group' in row ? (
							<tr class="group">
								<th colspan="3">{row.group}</th>
							</tr>
						) : (
							<tr>
								<th scope="row">{row.label}</th>
								{'same' in row ? (
									<td colspan="2" class="same">
										<span class="chip-neutral mr-2.5 align-[1px]">Same on both</span>
										<span class="font-medium text-ink">{row.same}</span>
									</td>
								) : (
									[
										{ cell: row.us, who: us.name, cls: 'oo font-medium text-ink' },
										{ cell: row.them, who: them.name, cls: 'theirs text-ink-soft' },
									].map(({ cell, who, cls }) => (
										<td class={cls}>
											<span class="who">{who}</span>
											<span class="flex items-start gap-2.5">
												{cell.mark ? (
													<span class={`mark mark-${cell.mark}`}>
														{cell.mark === 'yes' ? (
															<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 8.5l3 3L12.5 5" /></svg>
														) : cell.mark === 'no' ? (
															<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 5l6 6M11 5l-6 6" /></svg>
														) : (
															<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true"><path d="M4.5 8h7" /></svg>
														)}
														<span class="sr-only">{MARK_LABEL[cell.mark]}: </span>
													</span>
												) : (
													<span class="mark" aria-hidden="true"></span>
												)}
												<span class="min-w-0">
													{cell.text}
													{cell.note ? <span class="note">{cell.note}</span> : null}
												</span>
											</span>
										</td>
									))
								)}
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<p class="caption mt-4 flex flex-wrap items-center gap-x-4 gap-y-1">
				<span class="inline-flex items-center gap-1.5"><span class="mark mark-yes" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8.5l3 3L12.5 5" /></svg></span>Yes</span>
				<span class="inline-flex items-center gap-1.5"><span class="mark mark-partial" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round"><path d="M4.5 8h7" /></svg></span>Partly</span>
				<span class="inline-flex items-center gap-1.5"><span class="mark mark-no" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 5l6 6M11 5l-6 6" /></svg></span>No</span>
				{page.matrix.caption ? <span>{page.matrix.caption}</span> : null}
			</p>
		</div>
	</section>

	{page.timeline ? (
		<section id="status" class="scroll-mt-20 rule">
			<div class="container-x section split-head">
				<div>
					<h2 class="h-section">{page.timeline.title}</h2>
					<p class="lede mt-6 max-w-xl">{page.timeline.lede}</p>
				</div>
				<ol class="timeline">
					{page.timeline.events.map((event) => (
						<li class="relative pb-7 pl-7 last:pb-0">
							<span class="absolute left-0 top-[7px] h-2.5 w-2.5 rounded-full border-2 border-orange bg-paper" aria-hidden="true"></span>
							<p class="font-mono text-[12.5px] tabular-nums text-ink-faint">
								{event.date === 'Since' ? event.date : <time datetime={event.iso}>{event.date}</time>}
							</p>
							<p class="mt-1 text-[15px] leading-snug">
								{event.text}
								{event.href ? (
									<>
										{' '}
										<a href={event.href} class="link whitespace-nowrap text-[13px]" rel="noopener">source</a>
									</>
								) : null}
							</p>
						</li>
					))}
				</ol>
			</div>
		</section>
	) : null}

	{page.stats ? (
		<section id="storage" class="scroll-mt-20 rule">
			<div class="container-x section">
				<div class="split-head">
					<h2 class="h-section">{page.stats.title}</h2>
					<p class="lede">{page.stats.lede}</p>
				</div>
				<ul class={`mt-12 grid gap-4 ${page.stats.items.length === 3 ? 'md:grid-cols-3' : 'sm:grid-cols-2 lg:grid-cols-4'}`}>
					{page.stats.items.map((stat) => (
						<li class="card flex flex-col p-6">
							<p class="stat text-balance text-[2rem] text-orange-deep">{stat.value}</p>
							<p class="mt-4 text-[15px] font-semibold">{stat.label}</p>
							<p class="mt-1.5 text-[14px] leading-snug text-ink-soft">{stat.body}</p>
						</li>
					))}
				</ul>
				{page.stats.caption ? <p class="caption mt-4">{page.stats.caption}</p> : null}
			</div>
		</section>
	) : null}

	{page.quotes ? (
		<section id="quotes" class="scroll-mt-20 rule">
			<div class="container-x section">
				<div class="split-head">
					<h2 class="h-section">{page.quotes.title}</h2>
					<p class="lede">{page.quotes.lede}</p>
				</div>
				<ul class="mt-12 grid gap-4 md:grid-cols-2">
					{page.quotes.items.map((item) => (
						<li class="card flex flex-col p-6 md:p-7">
							<blockquote cite={item.href} class="text-[17px] font-medium leading-snug tracking-[-0.01em]">“{item.quote}”</blockquote>
							<p class="mt-4 text-[14px] leading-snug text-ink-soft">
								{item.when}{' '}
								<a href={item.href} class="link whitespace-nowrap text-[13px]" rel="noopener">source</a>
							</p>
						</li>
					))}
				</ul>
			</div>
		</section>
	) : null}

	<!-- Sources. -->
	<section class="rule">
		<div class="container-x py-10">
			<p class="label">Sources, read {AS_OF.label}</p>
			<ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-[13px]">
				{page.sources.map((source) => (
					<li><a href={source.href} class="text-ink-soft underline decoration-ink-faint/40 underline-offset-2 hover:text-ink" rel="noopener">{source.label}</a></li>
				))}
			</ul>
		</div>
	</section>

	{page.cta.primary ? (
		<section class="rule">
			<div class="container-x section">
				<h2 class="h-section max-w-3xl">{page.cta.title}</h2>
				<p class="lede mt-6 max-w-xl">{page.cta.body}</p>
				<div class="mt-9 flex flex-col gap-3 sm:flex-row">
					<a href={page.cta.primary.href} class="btn-primary">{page.cta.primary.label}</a>
					{page.cta.secondary ? <a href={page.cta.secondary.href} class="btn-secondary">{page.cta.secondary.label}</a> : null}
				</div>
			</div>
		</section>
	) : (
		<Cta title={page.cta.title} body={page.cta.body} />
	)}
</Base>

<style>
	/* The matrix. Kept identical to the one in vs-workerd.astro. */
	.matrix th,
	.matrix td {
		padding: 0.875rem 1.25rem;
		border-bottom: 1px solid var(--color-line);
		vertical-align: top;
	}
	.matrix thead th {
		padding-top: 1rem;
		padding-bottom: 1rem;
		font-size: 15px;
		font-weight: 600;
	}
	.matrix tbody th {
		font-size: 15px;
		font-weight: 500;
		line-height: 1.4;
	}
	.matrix td {
		font-size: 14.5px;
		line-height: 1.45;
	}
	.matrix tbody tr:last-child th,
	.matrix tbody tr:last-child td {
		border-bottom: 0;
	}
	/* A heading over the rows that follow it. Not in vs-workerd.astro. */
	.matrix tbody tr.group th {
		padding-top: 0.625rem;
		padding-bottom: 0.625rem;
		background: var(--color-paper-mid);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-ink-soft);
	}
	/* The OpenOrange column, lightly tinted down its length. */
	.matrix .oo {
		background: color-mix(in srgb, var(--color-orange-soft) 55%, transparent);
	}
	.matrix .note {
		display: block;
		margin-top: 0.2rem;
		font-size: 13px;
		font-weight: 400;
		color: var(--color-ink-faint);
	}
	.mark {
		display: inline-flex;
		width: 1.25rem;
		height: 1.25rem;
		flex: none;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
	}
	.mark svg {
		width: 0.75rem;
		height: 0.75rem;
	}
	.mark-yes {
		background: var(--color-orange);
		color: #fff;
	}
	/* A yes for the other product reads as a yes, without OpenOrange's orange. */
	.theirs .mark-yes {
		background: transparent;
		border: 1px solid color-mix(in srgb, var(--color-ink) 30%, transparent);
		color: var(--color-ink-soft);
	}
	.mark-no {
		border: 1px dashed color-mix(in srgb, var(--color-ink) 30%, transparent);
		color: var(--color-ink-faint);
	}
	.mark-partial {
		background: var(--color-paper-mid);
		color: var(--color-ink-soft);
	}
	/* Column names repeat inside each cell on phones, where the header is off screen. */
	.matrix .who {
		display: none;
	}
	/* Phones: the row label, then OpenOrange and the other product one under the
	   other, each cell labeled. Side by side, each would get a third of the
	   screen and wrap every few words. */
	@media (max-width: 639px) {
		.matrix,
		.matrix tbody {
			display: block;
		}
		.matrix thead {
			display: none;
		}
		.matrix tr {
			display: grid;
			grid-template-columns: minmax(0, 1fr);
			padding-bottom: 0.5rem;
			border-bottom: 1px solid var(--color-line);
		}
		.matrix tbody tr:last-child {
			border-bottom: 0;
		}
		.matrix th,
		.matrix td {
			width: auto;
			border: 0;
		}
		.matrix tbody th {
			grid-column: 1 / -1;
			padding: 0.875rem 1rem 0.375rem;
			font-size: 14.5px;
			font-weight: 600;
		}
		.matrix td {
			padding: 0.375rem 1rem;
			font-size: 13.5px;
		}
		.matrix .same {
			grid-column: 1 / -1;
		}
		/* The "Same on both" chip on its own line, so the text does not wrap under it. */
		.matrix .same > :first-child {
			display: table;
			margin-bottom: 0.375rem;
		}
		.matrix .who {
			display: block;
			margin-bottom: 0.375rem;
			font-size: 11px;
			font-weight: 600;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--color-ink-faint);
		}
		.matrix .oo .who {
			color: var(--color-orange-deep);
		}
		.mark {
			width: 1.125rem;
			height: 1.125rem;
		}
	}

	.timeline {
		position: relative;
	}
	.timeline::before {
		content: '';
		position: absolute;
		left: 4px;
		top: 12px;
		bottom: 12px;
		width: 2px;
		background: var(--color-line);
	}
</style>
